<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave existing files and folders (assets, PDF, PHP API)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: all other routes → index.html
  RewriteRule ^ index.html [L]
</IfModule>
