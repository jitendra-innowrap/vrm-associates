# Google SMTP (Gmail / Google Workspace) for contact & careers forms
# Use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=office@vrmca.in
SMTP_PASS=your-google-app-password
SMTP_FROM=office@vrmca.in
SMTP_TO=office@vrmca.in
# Optional second inbox for lead notifications (leave unset for office only)
# SMTP_TO_2=
